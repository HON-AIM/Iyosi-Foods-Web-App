# Copy to .env and fill in values. Never commit .env.

# Neon: pooled hostname contains "-pooler"
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon: direct hostname does NOT contain "-pooler"
DIRECT_URL="postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET=""
NEXTAUTH_SECRET=""

# Local
PORT=3001
NEXTAUTH_URL="http://localhost:3001"
AUTH_URL="http://localhost:3001"
AUTH_TRUST_HOST="true"

# Vercel production (set in dashboard, not in committed .env)
# NEXTAUTH_URL="https://iyosi-foods-web-app.vercel.app"
# AUTH_URL="https://iyosi-foods-web-app.vercel.app"

EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""
CONTACT_TO_EMAIL=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Paystack (https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY="sk_test_xxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxx"

# Vercel Blob (Dashboard → Storage → Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxx"

# Upstash Redis (console.upstash.com → REST API)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# WhatsApp click-to-chat (country code + number, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER="2348012345678"
