# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.development.local
.env.production.local
.env.test.local
!.env.example

# build artifacts
build-output.txt
tsconfig.tsbuildinfo

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated code
/src/generated/prisma

# prisma local databases
prisma/dev.db
prisma/*.db
prisma/dev.db-journal

# uploaded files (local dev only — production uses Vercel Blob)
public/uploads/*.jpg
public/uploads/*.jpeg
public/uploads/*.png
public/uploads/*.webp
public/uploads/*.gif

# security: never commit these
create-admin.js

# internal docs
docs/

.vercel
.env*
